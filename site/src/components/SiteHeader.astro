---
/**
 * The one header every page wears.
 *
 * The homepage and the report pages carried separate copies — different nav
 * labels ("API" on one, "JSON" on the other), a mark on one and none on the
 * other, two unrelated theme controls — which is the per-page duplication
 * `tokens.css` was extracted to end: a fix reaching one page and not its
 * siblings, with nothing failing.
 */
import "../styles/site-header.css";
import Wordmark from "./Wordmark.astro";

interface Props {
  /** Marks the nav entry for the section being read, for sighted and AT users. */
  current?: "servers";
}

const { current } = Astro.props;
---

<header class="site-header">
  <Wordmark />
  <nav class="site-nav" aria-label="Site">
    <a href="/servers/" aria-current={current === "servers" ? "page" : undefined}>Servers</a>
    <a href="/api/servers.json">API</a>
    <a href="https://github.com/kVadrum/mcpwatchman">Source</a>
    <a href="https://pypi.org/project/mcpwatchman/">PyPI</a>
  </nav>
  {/* Three positions, not a two-state icon, because there are three honest
    states and "following your system" is one of them. Real radios: the
    arrow-key behaviour, the grouping and the label association are the
    platform's, not ours. Exactly the markup `theme.js` wires — it looks for
    `.theme`, checks the radio matching the stored choice, and reveals the
    fieldset; `hidden` until then, because with JS off the CSS still follows
    the system and an override that does nothing must not be offered. */}
  <fieldset class="theme" hidden>
    <legend class="sr-only">Colour theme</legend>
    <input class="sr-only" type="radio" name="theme" id="theme-auto" value="auto" checked />
    <label for="theme-auto">Auto</label>
    <input class="sr-only" type="radio" name="theme" id="theme-dark" value="dark" />
    <label for="theme-dark">Dark</label>
    <input class="sr-only" type="radio" name="theme" id="theme-light" value="light" />
    <label for="theme-light">Light</label>
  </fieldset>
</header>
