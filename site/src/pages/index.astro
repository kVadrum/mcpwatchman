---
// Latin subsets only. The unscoped imports pull Cyrillic, Greek and Vietnamese
// too — 900 KB of fonts for an English-language page, against `06` §5's
// performance targets. Revisit if the site is ever translated (`06` §7).
import "@fontsource/ibm-plex-sans/latin-400.css";
import "@fontsource/ibm-plex-sans/latin-500.css";
import "@fontsource/ibm-plex-sans-condensed/latin-500.css";
import "@fontsource/ibm-plex-sans-condensed/latin-600.css";
import "@fontsource/ibm-plex-mono/latin-400.css";
import "@fontsource/ibm-plex-mono/latin-500.css";
// Canonical token home — see the file header for why it is not per-page.
import "../styles/tokens.css";
import scans from "../data/scans.json";

// Build-time, not hardcoded: a footer year that has to be remembered is a footer
// year that goes wrong. The site rebuilds on every deploy.
const year = new Date().getFullYear();

// Derived, never typed. These were computed once and pasted in as literals —
// 40/29/10 — and the very next data regeneration made them 40/32/8, so the
// homepage contradicted the server index and llms.txt, both of which derive
// from this same file. A number a human transcribes is a number that goes
// stale silently; the other surfaces already knew that.
const fetchedCount = scans.filter((r) => r.source_state === "fetched").length;
const unreachableCount = scans.filter((r) => r.source_state === "unreachable").length;

const axes = [
  { name: "Code Safety", weight: 30, reads: "Shell exec in tool handlers, unvalidated URL fetches, unsafe deserialization, path traversal — matched against an MCP-specific semgrep ruleset." },
  { name: "Auth Posture", weight: 20, reads: "Whether a server requires a key, uses OAuth, or accepts anyone — read against the transport it declares." },
  { name: "Dependency Health", weight: 20, reads: "Known CVEs in the resolved dependency set, via OSV. Transitive coverage where a lockfile exists, and said plainly where it doesn't." },
  { name: "Maintenance", weight: 15, reads: "Last commit, release cadence, open-to-closed issue ratio, sole-maintainer risk." },
  { name: "Transparency", weight: 15, reads: "License presence and SPDX validity, and whether the manifest's claims match what the code actually does." },
];

const ledger = [
  { label: "starting score", detail: "every axis opens at 100", value: 100, display: "100", kind: "start" },
  { label: "shell exec in a tool handler", detail: "critical severity · high confidence", value: -30, display: "−30.0", kind: "deduct" },
  // critical/HIGH, not medium. The deduction shown is 30 × 0.75; a Critical/Medium
  // is -20, so labelling it medium would make the published example score 55 while
  // the page claims 48 — a worked example contradicting our own shipped engine, on
  // the one page whose entire argument is that our numbers can be checked.
  { label: "SSRF, no host allowlist", detail: "critical · high · ×0.75, second of its severity", value: -22.5, display: "−22.5", kind: "deduct" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>mcpwatchman — independent security audit for MCP servers</title>
    <meta
      name="description"
      content="Continuous, evidence-linked security and quality audit of the servers in the official Model Context Protocol registry. Every point subtracted for a reason you can read."
    />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {/* Two tags, media-scoped, so the browser chrome follows the system theme
      with no script involved. `theme.js` rewrites the `media` attributes when
      the visitor picks a theme explicitly — `data-scheme` is what it keys on. */}
    <meta name="theme-color" data-scheme="dark" media="(prefers-color-scheme: dark)" content="#10151B" />
    <meta name="theme-color" data-scheme="light" media="(prefers-color-scheme: light)" content="#CCD3DB" />

    {/* Deliberately synchronous and deliberately in <head>: this applies a
      stored theme choice BEFORE the first paint. `defer` would apply it after
      the page has painted in the other theme, which is the flash it exists to
      prevent — and an inline snippet, the usual way to do this, is blocked by
      our own `script-src 'self'`. See the file's header. */}
    {/* `is:inline` means "leave this tag exactly as authored" — NOT "inline the
      code". With a src it stays an external same-origin file, which is what the
      CSP requires; without the directive Astro tries to bundle a public/ asset
      and fails the build. Classic script, not type="module": a module is
      deferred by spec, and deferred is precisely what this must not be. */}
    <script is:inline src="/theme.js"></script>
    <link rel="canonical" href="https://mcpwatchman.com/" />
    <meta property="og:title" content="mcpwatchman" />
    <meta property="og:description" content="Independent security audit for Model Context Protocol servers. Every point subtracted for a reason you can read." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://mcpwatchman.com" />
    <meta name="twitter:card" content="summary_large_image" />

    {/* Structured data. An inline <script type="application/ld+json"> is a DATA
      BLOCK, not executable script, so `script-src 'self'` does not block it —
      verified in a browser against the production CSP rather than assumed,
      since the same assumption about inline scripts was wrong once already.

      It is here because an agent parsing this page should not have to infer the
      project's identity, licence and status from prose. The `abstract` states
      the pre-v0.1 position explicitly: a machine reading this must not conclude
      that scores exist. */}
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "SoftwareApplication",
        "name": "mcpwatchman",
        "applicationCategory": "SecurityApplication",
        "operatingSystem": "Linux, macOS, Windows",
        "url": "https://mcpwatchman.com",
        "abstract": "Independent, continuous security and quality audit of servers in the official Model Context Protocol registry. Per-axis scores are published with the evidence behind every deduction; the weighted composite is computed and withheld until gold-set calibration validates the weights.",
        "description": "Scans the published source of MCP registry servers and reports evidence-linked, per-axis scores. Five axes are scored 0-100 independently: Code Safety, Auth Posture, Dependency Health, Maintenance, Transparency. Analysis is static; code is never executed and no running server is contacted.",
        "license": "https://spdx.org/licenses/MIT.html",
        "isAccessibleForFree": true,
        "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
        "codeRepository": "https://github.com/kVadrum/mcpwatchman",
        "downloadUrl": "https://pypi.org/project/mcpwatchman/",
        "softwareVersion": "0.9.0",
        "releaseNotes": "https://github.com/kVadrum/mcpwatchman/commits/main",
        "author": { "@type": "Organization", "name": "KeMeK Network", "url": "https://github.com/kVadrum" },
        "audience": {
          "@type": "Audience",
          "audienceType": "Developers and autonomous agents evaluating MCP servers before installation"
        },
        "about": {
          "@type": "Thing",
          "name": "Model Context Protocol",
          "url": "https://modelcontextprotocol.io"
        }
      }
    </script>
  </head>
  <body>
    <div class="frame">
      <header class="masthead">
        <a class="wordmark" href="/">
          <span class="wordmark__mark" aria-hidden="true"></span>
          mcpwatchman
        </a>
        <div class="masthead__controls">
          <nav class="masthead__nav">
            <a href="https://github.com/kVadrum/mcpwatchman">Source</a>
            <a href="https://pypi.org/project/mcpwatchman/">PyPI</a>
          </nav>
          {/* Three positions, not a two-state icon, because there are three
            honest states and "following your system" is one of them. An icon
            toggle has to hide that behind a guess about which way it will go,
            and this page's whole argument is against reporting a state it
            cannot support. Real radios: the arrow-key behaviour, the grouping
            and the label association are the platform's, not ours.

            `hidden` until theme.js reveals it — see that file. */}
          <fieldset class="theme" hidden>
            <legend class="sr-only">Colour theme</legend>
            <input class="sr-only" type="radio" name="theme" id="theme-auto" value="auto" checked />
            <label for="theme-auto">Auto</label>
            <input class="sr-only" type="radio" name="theme" id="theme-dark" value="dark" />
            <label for="theme-dark">Dark</label>
            <input class="sr-only" type="radio" name="theme" id="theme-light" value="light" />
            <label for="theme-light">Light</label>
          </fieldset>
        </div>
      </header>

      <main>
        {/* ─── hero: the ledger is the thesis ─── */}
        <section class="hero">
          <div class="hero__copy">
            <p class="eyebrow">Model Context Protocol · registry audit</p>
            <h1>
              Every point is subtracted<br />
              for a reason you can read.
            </h1>
            <p class="lede">
              mcpwatchman scans the servers in the official MCP registry and publishes
              what it found, not just what it concluded. A score is a ledger: it opens
              at 100, and every deduction names the finding, the file and the line that
              produced it.
            </p>
            <p class="status-line">
              <span class="pill">First scores</span>
              <a href="/servers/">{scans.length} servers are scanned and published</a>, per
              axis, with the file and line behind every deduction.
              {fetchedCount} shipped source we could read; {unreachableCount}
              declare a repository nobody can reach.
            </p>
          </div>

          {/* the signature: a light evidence document inside dark instrument chrome */}
          <figure class="ledger" aria-labelledby="ledger-caption">
            <div class="ledger__head">
              <span class="ledger__axis">Code Safety</span>
              <span class="ledger__meta">worked example</span>
            </div>
            <table class="ledger__table">
              <caption class="sr-only">
                How a Code Safety axis score of 48 is derived from two findings
              </caption>
              <tbody>
                {ledger.map((row) => (
                  <tr class={`row row--${row.kind}`}>
                    <th scope="row">
                      <span class="row__label">{row.label}</span>
                      <span class="row__detail">{row.detail}</span>
                    </th>
                    <td class="row__value">{row.display}</td>
                  </tr>
                ))}
                <tr class="row row--total">
                  <th scope="row">
                    <span class="row__label">axis score</span>
                    <span class="row__detail">47.5, rounded half-up — the score rounds, never the deduction</span>
                  </th>
                  <td class="row__value">
                    <span class="raw">47.5</span>
                    <span class="arrow" aria-hidden="true">→</span>
                    <span class="final" data-count-to="48">48</span>
                  </td>
                </tr>
              </tbody>
            </table>
            <figcaption id="ledger-caption" class="ledger__foot">
              Real arithmetic from the shipped engine. The second finding of a severity
              contributes 75% of its deduction, the third 50% — so twenty criticals and
              one critical don't score the same, and the worst finding still takes the
              undiminished hit.
            </figcaption>
          </figure>
        </section>

        {/* ─── the honesty section: the differentiator ─── */}
        <section class="band band--limits">
          <div class="band__inner">
            <p class="eyebrow">What this can and cannot see</p>
            <div class="limits">
              <div class="limits__stat">
                <span class="stat__figure">50.5<span class="stat__unit">%</span></span>
                <span class="stat__label">of a 100-server registry sample ships source we can read</span>
              </div>
              <div class="limits__prose">
                <p>
                  48 of those 99 active servers were remote-only — an endpoint, no published
                  source, nothing to analyse. We will say so on their page rather than show
                  you an empty score that looks like a verdict.
                </p>
                <p>
                  The analysis is static, always. We read published source, manifests and
                  lockfiles; we never execute the code we scan and never connect to a running
                  server. So the blind spot is whatever that source doesn't determine —
                  behaviour gated on remote configuration, code fetched at runtime, or a
                  deployment that differs from the repository it declares.
                </p>
                <p class="limits__note">
                  Publishing a coverage figure we'd rather were higher is the point, not an
                  aside. The numbers everyone quotes about MCP security come from parties
                  with something to sell, and nobody can check them.
                </p>
              </div>
            </div>
          </div>
        </section>

        {/* ─── the axes: weights are real data, not decoration ─── */}
        <section class="band band--axes">
          <div class="band__inner">
            <p class="eyebrow">Five axes · weights provisional until calibration</p>
            <ul class="axes">
              {axes.map((axis) => (
                <li class="axis">
                  <span class="axis__weight" aria-label={`weight ${axis.weight} percent`}>
                    {axis.weight}
                  </span>
                  <div class="axis__body">
                    <h3>{axis.name}</h3>
                    <p>{axis.reads}</p>
                  </div>
                </li>
              ))}
            </ul>
            <p class="gate">
              Each axis ships its own 0–100 score. The weighted composite is computed
              but <strong>not published</strong> until a hand-audited gold set says the weights
              are right — publishing an uncalibrated single number is how a methodology
              becomes marketing.
            </p>
          </div>
        </section>

        {/* ─── status ─── */}
        <section class="band band--now">
          <div class="band__inner">
            <p class="eyebrow">Where it actually is</p>
            <dl class="now">
              <div>
                <dt>Built</dt>
                <dd>Scoring engine and registry crawler, with tests. MIT, public.</dd>
              </div>
              <div>
                <dt>Next</dt>
                <dd>The scanner: source fetch, semgrep ruleset, dependency and auth checks.</dd>
              </div>
              <div>
                <dt>Not yet</dt>
                <dd>Any published score, the per-server pages, the API, the badge.</dd>
              </div>
            </dl>
            <div class="cta">
              <a class="cta__primary" href="https://github.com/kVadrum/mcpwatchman">
                Read the source
              </a>
              <a class="cta__secondary" href="https://github.com/kVadrum/mcpwatchman/issues">
                Tell us where the methodology is wrong
              </a>
            </div>
          </div>
        </section>
      </main>

      <footer class="colophon">
        <p>
          <span class="colophon__brand">mcpwatchman</span> — an independent audit, free
          and MIT-licensed, run by <a href="https://github.com/kVadrum">kVadrum</a>.
        </p>
        <p class="colophon__fine">
          Not affiliated with Anthropic or the official MCP registry. We overlay trust
          signal on registry metadata; the registry lists what exists, we assess what's safe.
        </p>
        <p class="colophon__rights">KeMeK Network &copy; {year}</p>
      </footer>
    </div>

    <script type="module" src="/ledger.js" defer></script>

    <style is:global>
      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      html {
        -webkit-text-size-adjust: 100%;
      }

      body {
        margin: 0;
        background: var(--ground);
        color: var(--ink);
        font-family: var(--font-body);
        font-size: clamp(1rem, 0.96rem + 0.2vw, 1.0625rem);
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
      }

      a {
        color: inherit;
      }

      :focus-visible {
        outline: 2px solid var(--signal-ink);
        outline-offset: 3px;
      }

      .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip-path: inset(50%);
        white-space: nowrap;
      }

      .frame {
        max-width: 78rem;
        margin: 0 auto;
        padding: 0 var(--gap);
      }

      /* ── masthead ───────────────────────────────────────────── */
      /* Mobile-first, because the wordmark and the controls do not fit on one
         line on a phone. Side by side they force the controls to wrap
         internally, which drops the theme options onto a second line and leaves
         the divider hairline dividing nothing — a stray vertical mark. Stacked,
         the nav and the three theme options sit on one comfortable row and the
         hairline does its job again. */
      .masthead {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 0.875rem;
        padding: 1.75rem 0;
        border-bottom: 1px solid var(--rule);
      }

      @media (min-width: 34rem) {
        .masthead {
          flex-direction: row;
          align-items: center;
          justify-content: space-between;
          gap: 1rem;
        }
      }

      .wordmark {
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
        font-family: var(--font-struct);
        font-weight: 600;
        font-size: 1.0625rem;
        letter-spacing: 0.02em;
        text-decoration: none;
      }

      .wordmark__mark {
        width: 0.7rem;
        height: 0.7rem;
        /* The RING takes --signal-ink and the lens inside it keeps the bright
           amber. On the dark theme the two are the same value and nothing
           changes; on the light theme a bright amber disc on lit slate is 1.39:1
           — a brand mark nobody can see — while a machined dark bezel holding an
           amber lens reads as more instrument, not less. */
        border: 2px solid var(--signal-ink);
        border-radius: 50%;
        position: relative;
      }

      .wordmark__mark::after {
        content: "";
        position: absolute;
        inset: 2px;
        border-radius: 50%;
        background: var(--signal);
      }

      .masthead__controls {
        display: flex;
        align-items: center;
        gap: 1.25rem 1.5rem;
        flex-wrap: wrap;
        justify-content: flex-start;
      }

      @media (min-width: 34rem) {
        .masthead__controls {
          justify-content: flex-end;
        }
      }

      /* ── theme selector ──────────────────────────────────────────────────
         Borrows the masthead's own vocabulary rather than introducing a new
         one: condensed uppercase micro-caps, and the amber underline the nav
         links already use to mark a live link. The selected position is marked
         the same way the rest of the page marks things, so the control reads as
         part of the instrument rather than a widget bolted to it. */
      .theme {
        display: flex;
        align-items: center;
        /* Tighter than the gap to its left, so the three options read as ONE
           control rather than as three more nav links. Without this the
           masthead is a flat row of five evenly-spaced words and the grouping
           has to be guessed from the labels. The hairline says it outright. */
        gap: 0.625rem;
        margin: 0;
        padding: 0 0 0 1.25rem;
        border: 0;
        border-left: 1px solid var(--rule);
        font-family: var(--font-struct);
        font-size: 0.6875rem;
        text-transform: uppercase;
        letter-spacing: 0.1em;
      }

      .theme[hidden] {
        display: none;
      }

      .theme label {
        color: var(--ink-faint);
        cursor: pointer;
        padding-bottom: 2px;
        border-bottom: 1px solid transparent;
        transition: color 120ms ease;
      }

      .theme label:hover {
        color: var(--ink-dim);
      }

      .theme input:checked + label {
        color: var(--ink);
        border-bottom-color: var(--signal-ink);
      }

      /* The input is visually hidden, so its focus ring has to be drawn on the
         label or keyboard users get no indicator at all. */
      .theme input:focus-visible + label {
        outline: 2px solid var(--signal-ink);
        outline-offset: 3px;
      }

      .masthead__nav {
        display: flex;
        gap: 1.5rem;
        font-family: var(--font-struct);
        font-size: 0.8125rem;
        text-transform: uppercase;
        letter-spacing: 0.09em;
        color: var(--ink-dim);
      }

      .masthead__nav a {
        text-decoration: none;
        padding-bottom: 2px;
        border-bottom: 1px solid transparent;
      }

      .masthead__nav a:hover {
        color: var(--ink);
        border-bottom-color: var(--signal-ink);
      }

      /* ── shared structure ───────────────────────────────────── */
      .eyebrow {
        font-family: var(--font-struct);
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.14em;
        color: var(--signal-ink);
        margin: 0 0 1.25rem;
      }

      /* ── hero ───────────────────────────────────────────────── */
      .hero {
        display: grid;
        gap: clamp(2.5rem, 5vw, 4.5rem);
        padding: clamp(3.5rem, 8vw, 6.5rem) 0 clamp(3rem, 6vw, 5rem);
        align-items: start;
      }

      @media (min-width: 62rem) {
        .hero {
          grid-template-columns: 1.05fr 0.95fr;
        }
      }

      .hero h1 {
        font-family: var(--font-struct);
        font-weight: 600;
        font-size: clamp(2.25rem, 1.3rem + 4vw, 4rem);
        line-height: 1.04;
        letter-spacing: -0.02em;
        margin: 0 0 1.5rem;
        text-wrap: balance;
      }

      .lede {
        margin: 0 0 1.75rem;
        max-width: 46ch;
        color: var(--ink-dim);
        font-size: 1.0625rem;
      }

      .status-line {
        display: flex;
        align-items: baseline;
        flex-wrap: wrap;
        gap: 0.65rem;
        margin: 0;
        max-width: 48ch;
        font-size: 0.9375rem;
        color: var(--ink-faint);
        border-left: 2px solid var(--rule);
        padding-left: 1rem;
      }

      .pill {
        flex: none;
        font-family: var(--font-data);
        font-size: 0.6875rem;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--signal-ink);
        border: 1px solid color-mix(in srgb, var(--signal-ink) 40%, transparent);
        border-radius: 999px;
        padding: 0.15rem 0.55rem;
      }

      /* ── the ledger: light document, dark chrome ────────────── */
      .ledger {
        margin: 0;
        background: var(--paper);
        color: var(--paper-ink);
        border-radius: 3px;
        box-shadow:
          0 1px 0 rgba(255, 255, 255, 0.06),
          0 18px 50px -20px rgba(0, 0, 0, 0.7);
        overflow: hidden;
      }

      .ledger__head {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 1rem;
        padding: 1rem 1.375rem;
        border-bottom: 1px solid var(--paper-rule);
        font-family: var(--font-struct);
      }

      .ledger__axis {
        font-weight: 600;
        font-size: 1rem;
        letter-spacing: 0.01em;
      }

      .ledger__meta {
        font-size: 0.6875rem;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        color: var(--paper-dim);
      }

      .ledger__table {
        width: 100%;
        border-collapse: collapse;
      }

      .ledger__table th {
        text-align: left;
        font-weight: 400;
      }

      .row > th,
      .row > td {
        padding: 0.8rem 1.375rem;
        border-bottom: 1px solid var(--paper-rule);
        vertical-align: baseline;
      }

      .row__label {
        display: block;
        font-size: 0.9375rem;
        line-height: 1.35;
      }

      .row__detail {
        display: block;
        margin-top: 0.15rem;
        font-family: var(--font-data);
        font-size: 0.6875rem;
        letter-spacing: 0.01em;
        color: var(--paper-dim);
      }

      .row__value {
        font-family: var(--font-data);
        font-variant-numeric: tabular-nums;
        font-size: 1.0625rem;
        text-align: right;
        white-space: nowrap;
      }

      .row--deduct .row__value {
        color: var(--deduct);
      }

      .row--total > th,
      .row--total > td {
        border-bottom: none;
        border-top: 2px solid var(--paper-ink);
        padding-top: 1rem;
        padding-bottom: 1.125rem;
      }

      .row--total .row__label {
        font-family: var(--font-struct);
        font-weight: 600;
      }

      .row--total .row__value .raw {
        color: var(--paper-dim);
        font-size: 0.875rem;
      }

      .row--total .row__value .arrow {
        color: var(--paper-dim);
        margin: 0 0.3rem;
        font-size: 0.8125rem;
      }

      .row--total .row__value .final {
        font-weight: 500;
        font-size: 1.75rem;
      }

      .ledger__foot {
        padding: 1.125rem 1.375rem 1.375rem;
        background: color-mix(in srgb, var(--paper) 92%, var(--paper-ink));
        font-size: 0.8125rem;
        line-height: 1.5;
        color: var(--paper-dim);
      }

      /* ── bands ──────────────────────────────────────────────── */
      .band {
        border-top: 1px solid var(--rule);
        padding: clamp(3rem, 7vw, 5rem) 0;
      }

      .band__inner {
        max-width: var(--measure);
      }

      .band--limits .band__inner,
      .band--axes .band__inner {
        max-width: none;
      }

      /* ── limits ─────────────────────────────────────────────── */
      .limits {
        display: grid;
        gap: clamp(1.75rem, 4vw, 3.5rem);
      }

      @media (min-width: 52rem) {
        .limits {
          grid-template-columns: minmax(14rem, 20rem) minmax(0, 1fr);
          align-items: start;
        }
      }

      .limits__stat {
        display: flex;
        flex-direction: column;
        gap: 0.65rem;
      }

      .stat__figure {
        display: flex;
        align-items: baseline;
        flex-wrap: nowrap;
        white-space: nowrap;
        gap: 0.08em;
        font-family: var(--font-data);
        font-variant-numeric: tabular-nums;
        font-size: clamp(3rem, 2rem + 4vw, 4.5rem);
        line-height: 1;
        letter-spacing: -0.03em;
        color: var(--signal-ink);
      }

      .stat__unit {
        font-size: 0.4em;
        letter-spacing: 0;
        color: var(--ink-faint);
      }

      .stat__label {
        font-size: 0.875rem;
        line-height: 1.45;
        color: var(--ink-dim);
        max-width: 26ch;
      }

      .limits__prose p {
        margin: 0 0 1.1rem;
        max-width: 62ch;
        color: var(--ink-dim);
      }

      .limits__prose p:last-child {
        margin-bottom: 0;
      }

      .limits__note {
        border-left: 2px solid var(--signal-ink);
        padding-left: 1rem;
        color: var(--ink) !important;
      }

      /* ── axes ───────────────────────────────────────────────── */
      .axes {
        list-style: none;
        margin: 0 0 2.5rem;
        padding: 0;
        border-top: 1px solid var(--rule);
      }

      .axis {
        display: grid;
        grid-template-columns: 3.5rem minmax(0, 1fr);
        gap: 1rem;
        align-items: baseline;
        padding: 1.375rem 0;
        border-bottom: 1px solid var(--rule);
      }

      @media (min-width: 52rem) {
        .axis {
          grid-template-columns: 5rem 16rem minmax(0, 1fr);
          gap: 2rem;
        }

        .axis__body {
          display: contents;
        }
      }

      .axis__weight {
        font-family: var(--font-data);
        font-variant-numeric: tabular-nums;
        font-size: 1.125rem;
        color: var(--signal-ink);
      }

      .axis__weight::after {
        content: "%";
        font-size: 0.65em;
        color: var(--ink-faint);
        margin-left: 0.06em;
        vertical-align: baseline;
      }

      /* Block by default. `display: contents` promotes h3 and p to grid children,
         which is only correct against the THREE-column desktop track list — on
         the two-column mobile grid the paragraph lands in the 3.5rem weight
         column and sets one word per line. Scoped to the wide breakpoint only. */
      .axis__body {
        min-width: 0;
      }

      .axis__body h3 {
        margin: 0;
        font-family: var(--font-struct);
        font-weight: 600;
        font-size: 1.0625rem;
        letter-spacing: 0.01em;
      }

      .axis__body p {
        margin: 0.35rem 0 0;
        font-size: 0.9375rem;
        color: var(--ink-dim);
        max-width: 58ch;
      }

      @media (min-width: 52rem) {
        .axis__body p {
          margin-top: 0;
        }
      }

      .gate {
        margin: 0;
        max-width: 62ch;
        color: var(--ink-dim);
      }

      .gate strong {
        color: var(--ink);
        font-weight: 500;
      }

      /* ── now ────────────────────────────────────────────────── */
      .now {
        margin: 0 0 2.5rem;
        display: grid;
        gap: 1rem;
      }

      @media (min-width: 46rem) {
        .now {
          grid-template-columns: repeat(3, minmax(0, 1fr));
          gap: 2rem;
        }
      }

      .now dt {
        font-family: var(--font-struct);
        font-size: 0.6875rem;
        text-transform: uppercase;
        letter-spacing: 0.13em;
        color: var(--signal-ink);
        margin-bottom: 0.4rem;
      }

      .now dd {
        margin: 0;
        font-size: 0.9375rem;
        color: var(--ink-dim);
      }

      .cta {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
      }

      .cta__primary,
      .cta__secondary {
        font-family: var(--font-struct);
        font-size: 0.875rem;
        letter-spacing: 0.02em;
        text-decoration: none;
        padding: 0.7rem 1.25rem;
        border: 1px solid var(--rule);
        border-radius: 2px;
      }

      .cta__primary {
        background: var(--signal);
        /* Not --signal: an amber fill on lit slate separates at 1.39:1, so the
           button's BOUNDARY is what has to carry the 3:1 a non-text control
           owes. On dark the two tokens are equal and this is a no-op. */
        border-color: var(--signal-ink);
        color: var(--signal-on);
        font-weight: 600;
      }

      .cta__primary:hover {
        /* Lightening on hover is right on the dark theme and wrong on the light
           one, where it walks the chip toward the page. The direction is a
           token, not a hardcoded mix. */
        background: var(--signal-hover);
      }

      .cta__secondary {
        color: var(--ink-dim);
      }

      .cta__secondary:hover {
        color: var(--ink);
        border-color: var(--ink-faint);
      }

      /* ── colophon ───────────────────────────────────────────── */
      .colophon {
        border-top: 1px solid var(--rule);
        padding: 2rem 0 3rem;
        font-size: 0.8125rem;
        color: var(--ink-faint);
      }

      .colophon p {
        margin: 0 0 0.6rem;
        max-width: 70ch;
      }

      .colophon__brand {
        font-family: var(--font-struct);
        font-weight: 600;
        color: var(--ink-dim);
      }

      .colophon__fine {
        margin-bottom: 0.6rem;
      }

      .colophon__rights {
        margin-bottom: 0;
        font-family: var(--font-struct);
        letter-spacing: 0.04em;
      }

      @media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
          animation-duration: 0.01ms !important;
          transition-duration: 0.01ms !important;
        }
      }
    </style>
  </body>
</html>
