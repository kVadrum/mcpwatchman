---
// Latin subsets only. The unscoped imports pull Cyrillic, Greek and Vietnamese
// too — 900 KB of fonts for an English-language page, against `06` §5's
// performance targets. Revisit if the site is ever translated (`06` §7).
import "@fontsource/ibm-plex-sans/latin-400.css";
import "@fontsource/ibm-plex-sans/latin-500.css";
import "@fontsource/ibm-plex-sans-condensed/latin-500.css";
import "@fontsource/ibm-plex-sans-condensed/latin-600.css";
import "@fontsource/ibm-plex-mono/latin-400.css";
import "@fontsource/ibm-plex-mono/latin-500.css";
// Canonical token home — see the file header for why it is not per-page.
import "../styles/tokens.css";
import VoidHatch from "../components/VoidHatch.astro";
import SiteHeader from "../components/SiteHeader.astro";
import scans from "../data/scans.json";

// Build-time, not hardcoded: a footer year that has to be remembered is a footer
// year that goes wrong. The site rebuilds on every deploy.
const year = new Date().getFullYear();

// Derived, never typed. These were computed once and pasted in as literals —
// 40/29/10 — and the very next data regeneration made them 40/32/8, so the
// homepage contradicted the server index and llms.txt, both of which derive
// from this same file. A number a human transcribes is a number that goes
// stale silently; the other surfaces already knew that.
const fetchedCount = scans.filter((r) => r.source_state === "fetched").length;
// SUBJECT, not state — see servers/index.astro. Counting package failures
// here asserted something false about third-party repositories.
const unreachableCount = scans.filter((r) => r.source_subject === "repository").length;
// The NEWEST scan, as servers/index.astro computes it: a delisted server keeps
// the last scan taken while it was listed, so the set stops sharing one date.
const lastScanned = scans.length
  ? scans.map((r) => r.scanned_at).reduce((a, b) => (a > b ? a : b)).slice(0, 10)
  : "";

// The data is the product, so it is also stated for agents: a Dataset node
// pointing at the JSON, dated by the scans rather than by the build. Built as
// an object and serialised, because Astro does not evaluate `{}` inside a
// literal <script> body.
const dataset = {
  "@context": "https://schema.org",
  "@type": "Dataset",
  name: "mcpwatchman scans of the official MCP registry",
  description: `Per-axis security and quality scores for ${scans.length} servers in the official Model Context Protocol registry, each with the coverage it was measured on and the evidence behind every deduction. The weighted composite is withheld until calibration.`,
  url: "https://mcpwatchman.com/servers/",
  dateModified: lastScanned,
  license: "https://spdx.org/licenses/MIT.html",
  isAccessibleForFree: true,
  creator: { "@type": "Organization", name: "KeMeK Network", url: "https://github.com/kVadrum" },
  distribution: {
    "@type": "DataDownload",
    encodingFormat: "application/json",
    contentUrl: "https://mcpwatchman.com/api/servers.json",
  },
};

const axes = [
  { key: "code_safety", name: "Code Safety", weight: 30, reads: "Shell exec in tool handlers, unvalidated URL fetches, unsafe deserialization, path traversal — matched against an MCP-specific semgrep ruleset." },
  { key: "auth_posture", name: "Auth Posture", weight: 20, reads: "Whether a server requires a key, uses OAuth, or accepts anyone — read against the transport it declares." },
  { key: "dependency_health", name: "Dependency Health", weight: 20, reads: "Known CVEs in the resolved dependency set, via OSV. Transitive coverage where a lockfile exists, and said plainly where it doesn't." },
  { key: "maintenance", name: "Maintenance", weight: 15, reads: "Last commit, release cadence, open-to-closed issue ratio, sole-maintainer risk." },
  { key: "transparency", name: "Transparency", weight: 15, reads: "License presence and SPDX validity, and whether the manifest's claims match what the code actually does." },
].map((axis) => ({
  ...axis,
  // "Scored" in the servers index's sense: the axis produced a number, which
  // may itself be partial. Same count, same word, so the two pages agree.
  scored: scans.filter((r) => r.axes[axis.key].score !== null).length,
}));
// Coverage bar geometry. SVG, because the CSP blocks `style="width:…"`.
const CW = 120;

// The worked example. `tests/test_site_example.py` reads these rows and checks
// each against the shipped engine: `base` is its deduction for the printed
// severity and confidence, `factor` its stacking for the row's place in its
// severity, and PUBLISHED what the engine scores the findings.
const START = 100;
const PUBLISHED = 48;
const findings = [
  { label: "shell exec in a tool handler", severity: "critical", confidence: "high", base: 30, factor: 1, note: "First of its severity: the full 30." },
  // critical/HIGH, not medium. The deduction shown is 30 × 0.75; a Critical/Medium
  // is -20, so labelling it medium would make the published example score 55 while
  // the page claims 48 — a worked example contradicting our own shipped engine, on
  // the one page whose entire argument is that our numbers can be checked.
  { label: "SSRF, no host allowlist", severity: "critical", confidence: "high", base: 30, factor: 0.75, note: "Second of its severity: 75% of 30." },
];
// Each step is the slice of the 0–100 axis it removes, drawn on the readout
// meter. Plain floats are exact here only because every value is a binary
// fraction (30, 0.75, 22.5); the engine's 0.10 stacking step is not, and an
// example reaching it would print float noise in "from {raw}".
let balance = START;
const steps = findings.map((f) => {
  const deduction = f.base * f.factor;
  const step = { ...f, deduction, from: balance - deduction };
  balance -= deduction;
  return step;
});
const raw = balance;
const lost = START - raw;
const minus = (n: number) => `−${n.toFixed(1)}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>mcpwatchman — independent security audit for MCP servers</title>
    <meta
      name="description"
      content="Continuous, evidence-linked security and quality audit of the servers in the official Model Context Protocol registry. Every point subtracted for a reason you can read."
    />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {/* Two tags, media-scoped, so the browser chrome follows the system theme
      with no script involved. `theme.js` rewrites the `media` attributes when
      the visitor picks a theme explicitly — `data-scheme` is what it keys on. */}
    <meta name="theme-color" data-scheme="dark" media="(prefers-color-scheme: dark)" content="#10151B" />
    <meta name="theme-color" data-scheme="light" media="(prefers-color-scheme: light)" content="#CCD3DB" />

    {/* Deliberately synchronous and deliberately in <head>: this applies a
      stored theme choice BEFORE the first paint. `defer` would apply it after
      the page has painted in the other theme, which is the flash it exists to
      prevent — and an inline snippet, the usual way to do this, is blocked by
      our own `script-src 'self'`. See the file's header. */}
    {/* `is:inline` means "leave this tag exactly as authored" — NOT "inline the
      code". With a src it stays an external same-origin file, which is what the
      CSP requires; without the directive Astro tries to bundle a public/ asset
      and fails the build. Classic script, not type="module": a module is
      deferred by spec, and deferred is precisely what this must not be. */}
    <script is:inline src="/theme.js"></script>
    <link rel="canonical" href="https://mcpwatchman.com/" />
    <meta property="og:title" content="mcpwatchman" />
    <meta property="og:description" content="Independent security audit for Model Context Protocol servers. Every point subtracted for a reason you can read." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://mcpwatchman.com" />
    <meta name="twitter:card" content="summary_large_image" />

    {/* Structured data. An inline <script type="application/ld+json"> is a DATA
      BLOCK, not executable script, so `script-src 'self'` does not block it —
      verified in a browser against the production CSP rather than assumed,
      since the same assumption about inline scripts was wrong once already.

      It is here because an agent parsing this page should not have to infer the
      project's identity, licence and status from prose. The `abstract` states
      that per-axis scores are published and the composite is withheld.
      No `softwareVersion`: it read 0.9.0 against a repo at 0.29 and a PyPI
      package at 0.2 — a typed version is wrong by the next release, and there
      is no one version this page could truthfully name. */}
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "SoftwareApplication",
        "name": "mcpwatchman",
        "applicationCategory": "SecurityApplication",
        "operatingSystem": "Linux, macOS, Windows",
        "url": "https://mcpwatchman.com",
        "abstract": "Independent, continuous security and quality audit of servers in the official Model Context Protocol registry. Per-axis scores are published with the evidence behind every deduction; the weighted composite is computed and withheld until gold-set calibration validates the weights.",
        "description": "Scans the published source of MCP registry servers and reports evidence-linked, per-axis scores. Five axes are scored 0-100 independently: Code Safety, Auth Posture, Dependency Health, Maintenance, Transparency. Analysis is static; code is never executed and no running server is contacted.",
        "license": "https://spdx.org/licenses/MIT.html",
        "isAccessibleForFree": true,
        "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
        "codeRepository": "https://github.com/kVadrum/mcpwatchman",
        "downloadUrl": "https://pypi.org/project/mcpwatchman/",
        "releaseNotes": "https://github.com/kVadrum/mcpwatchman/commits/main",
        "author": { "@type": "Organization", "name": "KeMeK Network", "url": "https://github.com/kVadrum" },
        "audience": {
          "@type": "Audience",
          "audienceType": "Developers and autonomous agents evaluating MCP servers before installation"
        },
        "about": {
          "@type": "Thing",
          "name": "Model Context Protocol",
          "url": "https://modelcontextprotocol.io"
        }
      }
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(dataset)} />
  </head>
  <body>
    <VoidHatch />
    <div class="frame">
      <SiteHeader />

      <main>
        {/* ─── hero: the ledger is the thesis ─── */}
        <section class="hero">
          <div class="hero__copy">
            <p class="kicker">An independent audit of the Model Context Protocol registry</p>
            <h1>
              Every point is subtracted<br />
              for a reason you can read.
            </h1>
            <p class="lede">
              mcpwatchman scans the servers in the official MCP registry and publishes
              what it found, not just what it concluded. A score is a ledger: it opens
              at 100, and every deduction names the finding, the file and the line that
              produced it.
            </p>
            <div class="cta cta--hero">
              <a class="cta__primary" href="/servers/">Browse all {scans.length} servers</a>
              <a class="cta__secondary" href="/api/servers.json">Get the data as JSON</a>
            </div>
            <p class="status-line">
              {fetchedCount} of {scans.length} shipped source we could read;{" "}
              {unreachableCount} declare a repository nobody can reach.{" "}
              Last scanned <time datetime={lastScanned}>{lastScanned}</time>.
            </p>
          </div>

          {/* the signature: a light evidence document inside dark instrument chrome */}
          <figure class="example" aria-labelledby="example-caption">
            <div class="example__doc">
              <p class="example__head">
                <span class="example__axis">Code Safety</span>{" "}
                <span class="example__meta">worked example</span>
              </p>
              <ol class="tally">
                <li class="tally__row">
                  <span class="tally__label">starting score</span>{" "}
                  <span class="tally__value">{START}</span>{" "}
                  <span class="tally__detail">Every axis opens at 100.</span>
                </li>
                {steps.map((s) => (
                  <li class="tally__row tally__row--deduct">
                    <span class="tally__label">{s.label}</span>{" "}
                    <span class="tally__value">{minus(s.deduction)}</span>{" "}
                    <span class="tally__detail">
                      {s.severity[0].toUpperCase() + s.severity.slice(1)}, {s.confidence} confidence.{" "}
                      {s.note}
                    </span>
                  </li>
                ))}
              </ol>
            </div>
            {/* Drawn in PERCENTAGES with no viewBox: positions scale with the
              width while text and strokes keep their real size, so a label can
              sit centred under the slice it names at any width. */}
            <div class="readout">
              <p class="readout__line">
                <span class="readout__label">
                  Axis score{" "}
                  <span class="readout__raw">from {raw}, rounded half up</span>
                </span>{" "}
                <span class="final" data-count-to={PUBLISHED}>{PUBLISHED}</span>
              </p>
              <svg
                class="readout__meter"
                width="100%"
                height="34"
                role="img"
                aria-label={`Code Safety: ${raw} of 100 kept after ${minus(lost)} in deductions, published as ${PUBLISHED}`}
                data-start={START}
                data-steps={steps.map((s) => s.from).join(" ")}
              >
                {steps.map((s) => (
                  <rect class="m-lost" x={`${s.from}%`} y="0" width={`${s.deduction}%`} height="12" />
                ))}
                {steps.slice(1).map((s) => (
                  <line class="m-split" x1={`${s.from + s.deduction}%`} y1="0" x2={`${s.from + s.deduction}%`} y2="12" />
                ))}
                <rect class="m-scored" x="0" y="0.5" width={`${raw}%`} height="11" />
                <text class="m-kept-label" x="0" y="30">{raw} kept</text>{" "}
                {steps.map((s) => (
                  <>
                    <text class="m-lost-label" x={`${s.from + s.deduction / 2}%`} y="30" text-anchor="middle">{minus(s.deduction)}</text>{" "}
                  </>
                ))}
              </svg>
            </div>
            <figcaption id="example-caption" class="example__caption">
              Real arithmetic from the shipped engine. Only the score is rounded, never a
              deduction. The second finding of a severity contributes 75% of its deduction,
              the third 50% — so twenty criticals and one critical don't score the same,
              and the worst finding still takes the undiminished hit.
            </figcaption>
          </figure>
        </section>

        {/* ─── the honesty section: the differentiator ─── */}
        <section class="band band--limits">
          <div class="band__inner">
            <h2 class="band__title">What this can and cannot see</h2>
            <div class="limits">
              <div class="limits__stat">
                <span class="stat__figure">50.5<span class="stat__unit">%</span></span>
                <span class="stat__label">of a 100-server registry sample ships source we can read</span>
              </div>
              <div class="limits__prose">
                <p>
                  48 of those 99 active servers were remote-only — an endpoint, no published
                  source, nothing to analyse. We will say so on their page rather than show
                  you an empty score that looks like a verdict.
                </p>
                <p>
                  The analysis is static, always. We read published source, manifests and
                  lockfiles; we never execute the code we scan and never connect to a running
                  server. So the blind spot is whatever that source doesn't determine —
                  behaviour gated on remote configuration, code fetched at runtime, or a
                  deployment that differs from the repository it declares.
                </p>
                <p class="limits__note">
                  Publishing a coverage figure we'd rather were higher is the point, not an
                  aside. The numbers everyone quotes about MCP security come from parties
                  with something to sell, and nobody can check them.
                </p>
              </div>
            </div>
          </div>
        </section>

        {/* ─── the axes: weights are real data, not decoration ─── */}
        <section class="band band--axes">
          <div class="band__inner">
            <h2 class="band__title">Five axes, each scored on its own</h2>
            <ul class="axes">
              {axes.map((axis) => (
                <li class="axis">
                  <span class="axis__weight" aria-label={`weight ${axis.weight} percent`}>
                    {axis.weight}
                  </span>
                  <div class="axis__body">
                    <h3>{axis.name}</h3>
                    <p>{axis.reads}</p>
                  </div>
                  <p class="axis__cover">
                    <svg viewBox={`0 0 ${CW} 6`} width={CW} height="6" aria-hidden="true">
                      <rect class="c-scored" x="0" y="0" width={(CW * axis.scored) / scans.length} height="6" />
                      {axis.scored < scans.length && (
                        <rect
                          class="c-void"
                          x={(CW * axis.scored) / scans.length}
                          y="0"
                          width={CW - (CW * axis.scored) / scans.length}
                          height="6"
                          fill="url(#void-hatch)"
                        />
                      )}
                    </svg>
                    <span>scored for <b>{axis.scored}</b> of {scans.length}</span>
                  </p>
                </li>
              ))}
            </ul>
            <p class="gate">
              The hatched share of each bar is servers that axis could not be
              assessed for — a missing lockfile, an unreachable repository — and
              each <a href="/servers/">server's page</a> says which.
            </p>
            <p class="gate">
              Each axis ships its own 0–100 score, and the weights beside them are
              provisional. The weighted composite is computed but{" "}
              <strong>not published</strong> until a hand-audited gold set says the weights
              are right — publishing an uncalibrated single number is how a methodology
              becomes marketing.
            </p>
          </div>
        </section>

        {/* ─── status ─── */}
        <section class="band band--now">
          <div class="band__inner">
            <h2 class="band__title">Where it actually is</h2>
            <dl class="now">
              <div>
                <dt>Live</dt>
                <dd>
                  <a href="/servers/">{scans.length} server pages</a>, every deduction
                  linked to its file and line. The same data as JSON, per server or{" "}
                  <a href="/api/servers.json">as one file</a>, an{" "}
                  <a href="/llms.txt">llms.txt</a> index for agents, and{" "}
                  <code>mcpwatchman check</code> to read a server from a terminal.
                  Every server is rescanned nightly; the current data was scanned on{" "}
                  <time datetime={lastScanned}>{lastScanned}</time>.
                </dd>
              </div>
              <div>
                <dt>Next</dt>
                <dd>
                  The gold set: about thirty servers audited by hand, which
                  measure each rule's false-positive rate and calibrate the weights.
                </dd>
              </div>
              <div>
                <dt>Not yet</dt>
                <dd>
                  The weighted composite, withheld until calibrated. The badge,
                  the RSS feed.
                </dd>
              </div>
            </dl>
            <div class="cta">
              <a class="cta__primary" href="/servers/">Browse all {scans.length} servers</a>
              <a class="cta__secondary" href="https://github.com/kVadrum/mcpwatchman">
                Read the source
              </a>
              <a class="cta__secondary" href="https://github.com/kVadrum/mcpwatchman/issues">
                Tell us where the methodology is wrong
              </a>
            </div>
          </div>
        </section>
      </main>

      <footer class="colophon">
        <p>
          <span class="colophon__brand">mcpwatchman</span> — an independent audit, free
          and MIT-licensed, run by <a href="https://github.com/kVadrum">kVadrum</a>.
        </p>
        <p class="colophon__fine">
          Not affiliated with Anthropic or the official MCP registry. We overlay trust
          signal on registry metadata; the registry lists what exists, we assess what's safe.
        </p>
        <p class="colophon__rights">KeMeK&nbsp;Network &copy; {year}</p>
      </footer>
    </div>

    <script type="module" src="/ledger.js" defer></script>

    <style is:global>
      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      html {
        -webkit-text-size-adjust: 100%;
      }

      body {
        margin: 0;
        background: var(--ground);
        color: var(--ink);
        font-family: var(--font-body);
        font-size: clamp(1rem, 0.96rem + 0.2vw, 1.0625rem);
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
      }

      a {
        color: inherit;
      }

      :focus-visible {
        outline: 2px solid var(--signal-ink);
        outline-offset: 3px;
      }

      .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip-path: inset(50%);
        white-space: nowrap;
      }

      .frame {
        max-width: 78rem;
        margin: 0 auto;
        padding: 0 var(--gap);
      }

      /* ── header ─────────────────────────────────────────────── */
      /* The header itself is shared (`SiteHeader.astro`, `site-header.css`);
         only its place in this page's frame is set here. */
      .frame > .site-header {
        padding: 1.75rem 0;
        border-bottom: 1px solid var(--rule);
      }

      /* ── shared structure ───────────────────────────────────── */
      /* Sentence case, untracked. These were tracked all-caps eyebrows over
         every band, and the bands had no real headings at all — so a screen
         reader's outline of the page was a single h1. */
      .kicker {
        font-family: var(--font-struct);
        font-size: 1rem;
        font-weight: 600;
        color: var(--signal-ink);
        margin: 0 0 1.25rem;
      }

      .band__title {
        font-family: var(--font-struct);
        font-size: 1.375rem;
        font-weight: 600;
        line-height: 1.25;
        letter-spacing: -0.005em;
        color: var(--ink);
        margin: 0 0 1.5rem;
      }

      /* ── hero ───────────────────────────────────────────────── */
      .hero {
        display: grid;
        gap: clamp(2.5rem, 5vw, 4.5rem);
        padding: clamp(3.5rem, 8vw, 6.5rem) 0 clamp(3rem, 6vw, 5rem);
        align-items: start;
      }

      @media (min-width: 62rem) {
        .hero {
          grid-template-columns: 1.05fr 0.95fr;
        }
      }

      .hero h1 {
        font-family: var(--font-struct);
        font-weight: 600;
        font-size: clamp(2.25rem, 1.3rem + 4vw, 4rem);
        line-height: 1.04;
        letter-spacing: -0.02em;
        margin: 0 0 1.5rem;
        text-wrap: balance;
      }

      .lede {
        margin: 0 0 1.75rem;
        max-width: 46ch;
        color: var(--ink-dim);
        font-size: 1.0625rem;
      }

      .status-line {
        margin: 0;
        max-width: 48ch;
        font-size: 0.9375rem;
        color: var(--ink-faint);
        border-left: 2px solid var(--rule);
        padding-left: 1rem;
      }

      /* The data is the page's primary action, so it sits directly under the
         lede rather than inside a sentence at the bottom of the hero. */
      .cta--hero {
        margin: 0 0 1.75rem;
      }

      .status-line time {
        white-space: nowrap;
      }

      /* The hatch pattern's colour is a theme token; the pattern itself is
         defined once by <VoidHatch />, as on the report pages. */
      .hatch-defs {
        position: absolute;
      }

      .hatch-line {
        stroke: var(--void);
      }

      /* ── the worked example: evidence on paper, readout on the instrument ── */
      /* The paper carries the ledger; the meter beneath it sits on the page's
         own ground, drawn exactly as every server page draws an axis (amber
         kept, red lost), so the example teaches the reading of the real ones. */
      .example {
        margin: 0;
        --inset: 1.375rem;
      }

      .example__doc {
        background: var(--paper);
        color: var(--paper-ink);
        border-radius: 3px;
        padding: 1.125rem var(--inset) 0.375rem;
      }

      .example__head {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 1rem;
        margin: 0 0 0.875rem;
        font-family: var(--font-struct);
      }

      .example__axis {
        font-weight: 600;
        font-size: 1rem;
      }

      .example__meta {
        font-size: 0.8125rem;
        color: var(--paper-dim);
      }

      .tally {
        list-style: none;
        margin: 0;
        padding: 0;
      }

      .tally__row {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        column-gap: 1rem;
        padding: 0.8rem 0 0.85rem;
        border-top: 1px solid var(--paper-rule);
      }

      .tally__label {
        font-size: 0.9375rem;
        line-height: 1.35;
      }

      .tally__value {
        grid-row: 1;
        grid-column: 2;
        font-family: var(--font-data);
        font-variant-numeric: tabular-nums;
        font-size: 1rem;
        line-height: 1.35;
        text-align: right;
      }

      .tally__row--deduct .tally__value {
        color: var(--paper-deduct);
      }

      .tally__detail {
        grid-column: 1 / -1;
        margin-top: 0.15rem;
        font-size: 0.8125rem;
        line-height: 1.45;
        color: var(--paper-dim);
      }

      .readout {
        padding: 1.75rem var(--inset) 0;
      }

      .readout__line {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 1rem;
        margin: 0 0 0.75rem;
      }

      .readout__label {
        font-family: var(--font-struct);
        font-weight: 600;
        font-size: 1rem;
        line-height: 1.3;
      }

      .readout__raw {
        display: block;
        font-family: var(--font-body);
        font-weight: 400;
        font-size: 0.8125rem;
        color: var(--ink-dim);
      }

      .readout .final {
        font-family: var(--font-data);
        font-variant-numeric: tabular-nums;
        font-size: 2.5rem;
        font-weight: 500;
        line-height: 0.9;
      }

      .readout__meter {
        display: block;
        overflow: visible;
      }

      .m-lost {
        fill: var(--deduct);
      }

      .m-split {
        stroke: var(--ground);
        stroke-width: 2;
      }

      .m-scored {
        fill: var(--signal);
        stroke: var(--signal-ink);
        stroke-width: 1;
      }

      .m-kept-label,
      .m-lost-label {
        font-family: var(--font-data);
        font-variant-numeric: tabular-nums;
        font-size: 12.5px;
      }

      .m-kept-label {
        fill: var(--signal-ink);
      }

      .m-lost-label {
        fill: var(--deduct);
      }

      /* Set only by ledger.js, so with no script every label is visible.
         A transition runs on the value of the state being ENTERED, so hiding
         is instant and only the reveal fades — otherwise the labels linger
         for a beat over a bar that has just refilled to 100. */
      .m-kept-label,
      .m-lost-label {
        transition: opacity 180ms ease-out;
      }

      .m-kept-label.is-pending,
      .m-lost-label.is-pending {
        opacity: 0;
        transition: none;
      }

      .example__caption {
        margin: 1.125rem var(--inset) 0;
        padding-top: 1.125rem;
        border-top: 1px solid var(--rule);
        font-size: 0.875rem;
        line-height: 1.55;
        color: var(--ink-faint);
      }

      /* ── bands ──────────────────────────────────────────────── */
      .band {
        border-top: 1px solid var(--rule);
        padding: clamp(3rem, 7vw, 5rem) 0;
      }

      .band__inner {
        max-width: var(--measure);
      }

      .band--limits .band__inner,
      .band--axes .band__inner {
        max-width: none;
      }

      /* ── limits ─────────────────────────────────────────────── */
      .limits {
        display: grid;
        gap: clamp(1.75rem, 4vw, 3.5rem);
      }

      @media (min-width: 52rem) {
        .limits {
          grid-template-columns: minmax(14rem, 20rem) minmax(0, 1fr);
          align-items: start;
        }
      }

      .limits__stat {
        display: flex;
        flex-direction: column;
        gap: 0.65rem;
      }

      .stat__figure {
        display: flex;
        align-items: baseline;
        flex-wrap: nowrap;
        white-space: nowrap;
        gap: 0.08em;
        font-family: var(--font-data);
        font-variant-numeric: tabular-nums;
        font-size: clamp(3rem, 2rem + 4vw, 4.5rem);
        line-height: 1;
        letter-spacing: -0.03em;
        color: var(--signal-ink);
      }

      .stat__unit {
        font-size: 0.4em;
        letter-spacing: 0;
        color: var(--ink-faint);
      }

      .stat__label {
        font-size: 0.875rem;
        line-height: 1.45;
        color: var(--ink-dim);
        max-width: 26ch;
      }

      .limits__prose p {
        margin: 0 0 1.1rem;
        max-width: 62ch;
        color: var(--ink-dim);
      }

      .limits__prose p:last-child {
        margin-bottom: 0;
      }

      .limits__note {
        border-left: 2px solid var(--signal-ink);
        padding-left: 1rem;
        color: var(--ink) !important;
      }

      /* ── axes ───────────────────────────────────────────────── */
      .axes {
        list-style: none;
        margin: 0 0 2.5rem;
        padding: 0;
        border-top: 1px solid var(--rule);
      }

      .axis {
        display: grid;
        grid-template-columns: 3.5rem minmax(0, 1fr);
        gap: 1rem;
        align-items: baseline;
        padding: 1.375rem 0;
        border-bottom: 1px solid var(--rule);
      }

      @media (min-width: 52rem) {
        .axis {
          grid-template-columns: 5rem 14rem minmax(0, 1fr) 11rem;
          gap: 2rem;
        }

        .axis__body {
          display: contents;
        }
      }

      .axis__weight {
        font-family: var(--font-data);
        font-variant-numeric: tabular-nums;
        font-size: 1.125rem;
        color: var(--signal-ink);
      }

      .axis__weight::after {
        content: "%";
        font-size: 0.65em;
        color: var(--ink-faint);
        margin-left: 0.06em;
        vertical-align: baseline;
      }

      /* Block by default. `display: contents` promotes h3 and p to grid children,
         which is only correct against the THREE-column desktop track list — on
         the two-column mobile grid the paragraph lands in the 3.5rem weight
         column and sets one word per line. Scoped to the wide breakpoint only. */
      .axis__body {
        min-width: 0;
      }

      .axis__body h3 {
        margin: 0;
        font-family: var(--font-struct);
        font-weight: 600;
        font-size: 1.0625rem;
        letter-spacing: 0.01em;
      }

      .axis__body p {
        margin: 0.35rem 0 0;
        font-size: 0.9375rem;
        color: var(--ink-dim);
        max-width: 58ch;
      }

      @media (min-width: 52rem) {
        .axis__body p {
          margin-top: 0;
        }
      }

      /* Coverage, per axis: how many published servers the axis produced a
         number for. Column 2 on the phone grid (under the description), its own
         fourth column on the wide one. */
      /* Bar above count at every width: side by side they overflow a 375px
         phone by the width of "of 492". */
      .axis__cover {
        grid-column: 2;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 0.4rem;
        margin: 0;
        font-family: var(--font-data);
        font-variant-numeric: tabular-nums;
        font-size: 0.75rem;
        color: var(--ink-faint);
        white-space: nowrap;
      }

      @media (min-width: 52rem) {
        .axis__cover {
          grid-column: 4;
        }
      }

      .axis__cover svg {
        flex: none;
        display: block;
      }

      .axis__cover b {
        color: var(--ink);
        font-weight: 500;
      }

      /* Fill in --signal, EDGE in --signal-ink: amber on lit slate is 1.39:1,
         so on the light theme the boundary is what makes the bar visible — the
         CTA chip's fix, for the same reason. On dark the two are equal. */
      .c-scored {
        fill: var(--signal);
        stroke: var(--signal-ink);
        stroke-width: 1;
      }

      .c-void {
        stroke: var(--rule);
        stroke-width: 1;
      }

      .gate {
        margin: 0 0 1rem;
        max-width: 62ch;
        color: var(--ink-dim);
      }

      .gate:last-child {
        margin-bottom: 0;
      }

      .gate a,
      .now dd a {
        text-decoration-color: var(--signal-ink);
        text-underline-offset: 0.2em;
      }

      .gate a:hover,
      .now dd a:hover {
        color: var(--ink);
      }

      .now code {
        font-family: var(--font-data);
        font-size: 0.875em;
      }

      .gate strong {
        color: var(--ink);
        font-weight: 500;
      }

      /* ── now ────────────────────────────────────────────────── */
      .now {
        margin: 0 0 2.5rem;
        display: grid;
        gap: 1rem;
      }

      @media (min-width: 46rem) {
        .now {
          grid-template-columns: repeat(3, minmax(0, 1fr));
          gap: 2rem;
        }
      }

      .now dt {
        font-family: var(--font-struct);
        font-size: 1rem;
        font-weight: 600;
        color: var(--signal-ink);
        margin-bottom: 0.3rem;
      }

      .now dd {
        margin: 0;
        font-size: 0.9375rem;
        color: var(--ink-dim);
      }

      .cta {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
      }

      .cta__primary,
      .cta__secondary {
        font-family: var(--font-struct);
        font-size: 0.875rem;
        letter-spacing: 0.02em;
        text-decoration: none;
        padding: 0.7rem 1.25rem;
        border: 1px solid var(--rule);
        border-radius: 2px;
      }

      .cta__primary {
        background: var(--signal);
        /* Not --signal: an amber fill on lit slate separates at 1.39:1, so the
           button's BOUNDARY is what has to carry the 3:1 a non-text control
           owes. On dark the two tokens are equal and this is a no-op. */
        border-color: var(--signal-ink);
        color: var(--signal-on);
        font-weight: 600;
      }

      .cta__primary:hover {
        /* Lightening on hover is right on the dark theme and wrong on the light
           one, where it walks the chip toward the page. The direction is a
           token, not a hardcoded mix. */
        background: var(--signal-hover);
      }

      .cta__secondary {
        color: var(--ink-dim);
      }

      .cta__secondary:hover {
        color: var(--ink);
        border-color: var(--ink-faint);
      }

      /* ── colophon ───────────────────────────────────────────── */
      .colophon {
        border-top: 1px solid var(--rule);
        padding: 2rem 0 3rem;
        font-size: 0.8125rem;
        color: var(--ink-faint);
      }

      .colophon p {
        margin: 0 0 0.6rem;
        max-width: 70ch;
      }

      .colophon__brand {
        font-family: var(--font-struct);
        font-weight: 600;
        color: var(--ink-dim);
      }

      .colophon__fine {
        margin-bottom: 0.6rem;
      }

      .colophon__rights {
        margin-bottom: 0;
        font-family: var(--font-struct);
        letter-spacing: 0.04em;
      }

      @media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
          animation-duration: 0.01ms !important;
          transition-duration: 0.01ms !important;
        }
      }
    </style>
  </body>
</html>
