---
import Report from "../../layouts/Report.astro";
import VoidHatch from "../../components/VoidHatch.astro";
import scans from "../../data/scans.json";

const AXES = [
  { key: "code_safety", label: "Code" },
  { key: "auth_posture", label: "Auth" },
  { key: "dependency_health", label: "Deps" },
  { key: "maintenance", label: "Maint" },
  { key: "transparency", label: "Transp" },
];

const reports = [...scans].sort((a, b) => a.name.localeCompare(b.name));
// Counted by what was READ, not by what produced a number. An unreachable
// server still scores Auth Posture, because the transport sub-check reads the
// registry manifest and needs no source — so "produced at least one score"
// would count nine servers nobody could open, which is the kind of true-but-
// misleading tally this project exists to avoid publishing.
const read = reports.filter((r) => r.source_state === "fetched");
// Keyed on the SUBJECT, not the state. An npm 404 also sets
// state="unreachable", and counting it here published "declares a
// repository nobody can read" about repositories that resolve fine.
const unreachableRepo = reports.filter((r) => r.source_subject === "repository");
const unreachablePkg = reports.filter((r) => r.source_subject === "package");
// ⚠ REPLACES a "N carry at least one partly-measured axis" tally that read
// 39 of 40 — a signal that fires for a condition shared by almost every row
// says nothing, and `base.md` § *Signal design* is explicit that it trains the
// reader to discount it. It was driven almost entirely by Auth Posture, which
// is partial for 38 servers because its transport sub-check needs no source.
//
// Per-axis coverage is the fact a reader actually needs, and it surfaces the
// one this page was silent about: Maintenance is scored for NOBODY, because
// the forge fetch does not exist. A whole weight-15 axis dark on every server
// is not something to leave inferable from five dashes in a row.
const coverage = AXES.map((axis) => ({
  ...axis,
  scored: reports.filter((r) => r.axes[axis.key].score !== null).length,
}));
// The MOST RECENT scan, not the first row's. Once a pinned server leaves the
// registry its page keeps the last scan taken while it was listed, so the set
// stops sharing one date — and "scanned on X" would then be false for it.
const lastScanned = reports.length
  ? reports.map((r) => r.scanned_at).reduce((a, b) => (a > b ? a : b)).slice(0, 10)
  : "";
const delisted = reports.filter((r) => r.registry_state === "delisted").length;
// Derived so the sentence retires itself. The alphabetical-head selection is
// why every published name currently begins `ai.`; the first growth step makes
// that false, and a hand-typed clause would have stayed on the page.
const allAiPrefixed = reports.length > 0 && reports.every((r) => r.name.startsWith("ai."));
const W = 96;
---

<Report
  title="Scanned servers — mcpwatchman"
  description="Per-axis security and quality scores for servers in the official Model Context Protocol registry, with the evidence behind every deduction."
  canonical="https://mcpwatchman.com/servers/"
>
  <VoidHatch />

  <div class="ledger-intro">
    <h1>Scanned servers</h1>
    <p>
      {reports.length} servers from the official registry, last scanned on {lastScanned}.
      Each axis is scored independently and shown with how much of it could
      actually be measured — the hatched part of a bar is the share nobody
      assessed, and it is drawn rather than rounded away.
    </p>
    <p>
      This set is pinned and only ever grows, so a page published here keeps its
      URL. It is <b>not</b> a random sample: the servers published first were
      drawn from the registry's alphabetical head{allAiPrefixed && <>, which is why every name here begins <code>ai.</code></>}, and everything added
      since is drawn from the whole registry.{delisted > 0 && ` ${delisted} of these servers are no longer listed in the registry; their pages say so and keep the last scan taken while they were.`}
    </p>
    <p>
      There is no single number for a server here. The weighted composite is
      computed and withheld until a hand-audited gold set validates the weights.
    </p>
    <p>
      Maintenance is scored for no server yet: it reads commit and release
      history from the hosting forge, and that retrieval is not built. It shows
      as not assessed rather than as a guess, and the axis counts for nothing
      until it can be measured.
    </p>
  </div>

  <p class="tally">
    <span><b>{reports.length}</b> servers sampled</span>
    <span><b>{read.length}</b> had source we could read</span>
    <span><b>{unreachableRepo.length}</b> declare a repository nobody can read</span>
    {unreachablePkg.length > 0 && (
      <span><b>{unreachablePkg.length}</b> publish a package we could not fetch</span>
    )}
  </p>

  <p class="tally">
    {coverage.map((axis) => (
      <span>
        <b>{axis.scored}</b>/{reports.length} scored on {axis.label}
      </span>
    ))}
  </p>

  <ul class="roster">
    {reports.map((report) => (
      <li>
        <a class="roster-link" href={`/servers/${report.slug}/`}>
          <span class="roster-name">
            {report.name}
            <span class="roster-state">
              {report.source_state === "fetched"
                ? `source read${report.files_scanned ? ` · ${report.files_scanned} files` : ""}`
                : report.source_subject === "repository"
                  ? "declared repository not publicly reachable"
                  : report.source_subject === "package"
                    ? "declared package could not be fetched from its registry"
                    : report.source_state.replace(/_/g, " ")}
            </span>
          </span>
          <span class="roster-axes">
            {AXES.map((axis) => {
              const a = report.axes[axis.key];
              const weight = Math.max(0, Math.min(1, Number(a.assessed_weight) || 0));
              const aw = W * weight;
              const sw = a.score === null ? 0 : (aw * a.score) / 100;
              return (
                <span class="mini">
                  <span class="mini-label">{axis.label}</span>
                  <span class="mini-value" data-none={a.score === null ? "true" : "false"}>
                    {a.score === null ? "—" : a.score}
                  </span>
                  <svg viewBox={`0 0 ${W} 5`} width={W} height="5" aria-hidden="true">
                    <rect class="m-lost" x="0" y="0" width={aw} height="5" />
                    {sw > 0 && <rect class="m-scored" x="0" y="0" width={sw} height="5" />}
                    {weight < 1 && (
                      <rect class="m-void" x={aw} y="0" width={W - aw} height="5" fill="url(#void-hatch)" />
                    )}
                  </svg>
                </span>
              );
            })}
          </span>
        </a>
      </li>
    ))}
  </ul>
</Report>
